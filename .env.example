# App configuration for TrueNAS. Copy to /mnt/ssd/redirect/.env and fill in.
PORT=8080
HOST=0.0.0.0
BASE_DOMAIN=johorstudio.com
ADMIN_HOST=re.johorstudio.com
PUBLIC_ADMIN_ORIGIN=https://re.johorstudio.com
AUTH_MODE=access
CF_ACCESS_TEAM_DOMAIN=https://YOUR-TEAM.cloudflareaccess.com
CF_ACCESS_AUD=YOUR_ACCESS_APPLICATION_AUD
ALLOWED_EMAILS=rafierosliputra@gmail.com
DB_PATH=/data/redirect.db
TIMEZONE=Asia/Kuala_Lumpur
APP_VERSION=1.0.0
SEED_DEMO=true
# Add every existing subdomain so no short link can shadow another service.
RESERVED_SLUGS=www,re,shop,mail,tele,ana,nextcloud,photos,files,cloud,apps,api,admin,order,umami,calendar,ftp,smtp
